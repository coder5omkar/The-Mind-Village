# ----------------------------------------------------------------------------
# The Village - environment variables
# Copy this file to `.env` and fill in the values.
# ----------------------------------------------------------------------------

# --- Database -----------------------------------------------------------------
# PostgreSQL (Neon in production, Docker/local Postgres in development).
# Neon pooled URL example:
# postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/village?sslmode=require
DATABASE_URL="postgresql://village:village@localhost:5432/village"

# --- NextAuth -----------------------------------------------------------------
# Production: the exact public URL of the deployment (no trailing slash),
# e.g. https://the-village.<subdomain>.workers.dev
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# --- Google OAuth --------------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs (both):
#   http://localhost:3000/api/auth/callback/google
#   https://<your-production-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Jev by TypeSafe AI (preferred, optional) ---------------------------------
# Jev is a typed-decision API (choice / score / noul), not a chat model. It is
# the preferred prediction engine: fast, cheap, calibrated.
# Keys starting with "jv_live_" use the hosted gateway automatically.
# Get a key: https://jevtypesafeai.com/pricing  (hosted, instant)
#        or: https://console.typesafe.ai/keys (official TypeSafe)
# Leave JEV_API_URL empty to auto-pick the endpoint, or set a compatible host
# (OpenRouter / DigitalOcean / Vercel gateway proxies).
JEV_API_KEY=""
JEV_API_URL=""
JEV_MODEL="jev-latest"

# --- DeepSeek (second tier, optional) ------------------------------------------
# When set, thoughts are analyzed by the DeepSeek model. When empty (or if the
# API fails), The Village falls back to its built-in local prediction engine
# (lib/predictor.ts) so the app always works.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-v4.1-flash"
