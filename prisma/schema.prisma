// The Village - data model
// Dev: SQLite. For production (PostgreSQL) switch `provider` to "postgresql"
// and set DATABASE_URL accordingly. The `Json` columns are supported by both.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (NextAuth / Auth.js with the Prisma adapter)
// ---------------------------------------------------------------------------

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  image         String?
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  thoughts      Thought[]
  residentPower ResidentPower[]
  createdAt     DateTime        @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// The Village
// ---------------------------------------------------------------------------

model Resident {
  id          String          @id @default(cuid())
  name        String          @unique
  district    String
  function    String
  shadow      String
  description String
  createdAt   DateTime        @default(now())
  thoughts    Thought[]       @relation("PrimaryResident")
  corrections Thought[]       @relation("CorrectedResident")
  power       ResidentPower[]
  edgesA      Neighborhood[]  @relation("ResidentA")
  edgesB      Neighborhood[]  @relation("ResidentB")
}

model Neighborhood {
  id          String   @id @default(cuid())
  residentAId String
  residentBId String
  strength    Float    @default(0.5)
  residentA   Resident @relation("ResidentA", fields: [residentAId], references: [id])
  residentB   Resident @relation("ResidentB", fields: [residentBId], references: [id])

  @@unique([residentAId, residentBId])
}

model Thought {
  id                      String    @id @default(cuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text                    String
  primaryResidentId       String?
  primaryResident         Resident? @relation("PrimaryResident", fields: [primaryResidentId], references: [id])
  confidence              Float?
  secondaryResidents      Json?
  neighbors               Json?
  suggestedAction         String?
  reasoning               String?
  source                  String? // "deepseek" | "local"
  userCorrectedResidentId String?
  userCorrectedResident   Resident? @relation("CorrectedResident", fields: [userCorrectedResidentId], references: [id])
  feedback                String? // "correct" | "wrong" | "partial"
  actionTaken             String?
  outcome                 String?
  createdAt               DateTime  @default(now())

  @@index([userId, createdAt])
}

model ResidentPower {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id])
  date       DateTime @default(now())
  power      Float    @default(0.5)

  @@unique([userId, residentId, date])
  @@index([userId, date])
}
